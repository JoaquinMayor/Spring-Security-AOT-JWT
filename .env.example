# =====================================================================
#  CLASE 16 - Ejemplo de variables de entorno con secretos.
#  1) Copia este archivo como ".env"  (el .env esta en .gitignore: NUNCA se sube a Git)
#  2) Reemplaza los valores por los tuyos.
#  3) Cargalos en tu terminal / IDE / plataforma de despliegue (Docker, Kubernetes, CI/CD...).
#
#  Para generar claves aleatorias seguras en Base64:
#     openssl rand -base64 32
# =====================================================================

# Clase 15 - firma de los JWT (minimo 256 bits = 32 bytes en Base64)
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# Clase 15 - OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Clase 16 - cifrado AES-256 (32 bytes en Base64) y pepper de contrasenas
AES_KEY=
PASSWORD_PEPPER=
